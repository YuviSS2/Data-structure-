### Practical No. 2 (A)

**Problem Statement:** Write a program to read marks of students of your class and display it.

```c
#include <stdio.h>

int main() {
    int n, i;

    // Step 1: Ask the user for the number of students
    printf("Enter the number of students in the class: ");
    scanf("%d", &n);

    int marks[n]; // Step 2: Declare an array to store marks

    // Step 3: Input marks for each student
    printf("Enter marks of %d students:\n", n);
    for(i = 0; i < n; i++) {
        printf("Student %d: ", i + 1);
        scanf("%d", &marks[i]);
    }

    // Step 4: Display the marks
    printf("\nMarks of students in the class:\n");
    for(i = 0; i < n; i++) {
        printf("Student %d: %d\n", i + 1, marks[i]);
    }

    return 0;
}
